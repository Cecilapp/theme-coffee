{#- News card: image, date, title, description. p: page, dark: bool -#}
{%- import 'partials/macros.html.twig' as coffee -%}
<article class="group relative flex h-full flex-col">
  <div class="relative aspect-video overflow-hidden rounded-3xl bg-night">
    {%- if p.image|default(null) %}
    {{ coffee.image(p.image, {width: 800, class: 'size-full object-cover transition duration-700 group-hover:scale-105'}) }}
    {%- endif %}
  </div>
  <div class="flex flex-1 flex-col pt-6">
    {%- if p.date|default(null) %}
    <time datetime="{{ p.date|date('Y-m-d') }}" class="kicker">{{ p.date|format_date('long') }}</time>
    {%- endif %}
    <h3 class="heading mt-3 text-2xl">
      <a href="{{ url(p) }}" class="transition after:absolute after:inset-0 group-hover:text-coffee">{{ p.title }}</a>
    </h3>
    {%- if p.description|default(null) %}
    <p class="mt-3 line-clamp-3 {{ dark ? 'text-cream/70' : 'text-ink/70' }}">{{ p.description }}</p>
    {%- endif %}
    <p class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-bold uppercase tracking-wider">{{ 'Read more'|trans }} {{ coffee.icon('arrow-right', 'size-4 transition group-hover:translate-x-1') }}</p>
  </div>
</article>
