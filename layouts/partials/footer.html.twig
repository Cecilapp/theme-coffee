{#- Site footer: brand, company info, socials, `footer` menu (columns via child menus), `legal` menu -#}
{%- import 'partials/macros.html.twig' as coffee -%}
{%- set columns = site.menus.footer is defined ? site.menus.footer|sort_by_weight : (site.menus.main is defined ? site.menus.main|sort_by_weight : []) -%}
<footer class="block-stack bg-night pb-10 text-cream">
  <div class="container-coffee">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="{{ url('/') }}" class="inline-block" aria-label="{{ site.title }}">
          {%- if site.coffee.logo|default(null) %}
          {{ coffee.image(site.coffee.logo, {alt: site.title, class: 'h-12 w-auto'}) }}
          {%- else %}
          <span class="heading text-4xl">{{ site.title }}</span>
          {%- endif %}
        </a>
        {%- if site.baseline|default(null) %}
        <p class="mt-4 text-lg text-cream/80">{{ site.baseline }}</p>
        {%- endif %}
        {%- if site.coffee.company|default(null) %}
        <div class="mt-6 space-y-2 text-sm text-cream/60">{{ site.coffee.company|trim|nl2br|markdown_to_html }}</div>
        {%- endif %}
        {%- if site.coffee.socials|default([])|length %}
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="{{ 'Social networks'|trans }}">
          {%- for social in site.coffee.socials %}
          <li>
            <a href="{{ social.url }}" target="_blank" rel="noopener me" class="flex size-11 items-center justify-center rounded-full bg-cream/10 transition hover:bg-coffee" title="{{ social.name|capitalize }}">
              {{- coffee.social_icon(social.name) }}<span class="sr-only">{{ social.name|capitalize }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </div>
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-8" aria-label="{{ 'Footer menu'|trans }}">
        {%- set flat = [] %}
        {%- for entry in columns %}
          {%- if site.menus[entry.id] is defined %}
        <div>
          <p class="kicker mb-4"><a href="{{ url(entry) }}" class="hover:text-coffee-light">{{ entry.name }}</a></p>
          <ul class="space-y-2">
            {%- for child in site.menus[entry.id]|sort_by_weight %}
            <li><a href="{{ url(child) }}" class="text-cream/70 transition hover:text-cream">{{ child.name }}</a></li>
            {%- endfor %}
          </ul>
        </div>
          {%- else %}
            {%- set flat = flat|merge([entry]) %}
          {%- endif %}
        {%- endfor %}
        {%- if flat|length %}
        <div class="order-first">
          <p class="kicker mb-4">{{ 'Explore'|trans }}</p>
          <ul class="space-y-2">
            {%- for entry in flat %}
            <li><a href="{{ url(entry) }}" class="text-cream/70 transition hover:text-cream">{{ entry.name }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        {%- endif %}
      </nav>
    </div>
    <div class="mt-16 flex flex-col gap-4 border-t border-cream/10 pt-8 text-sm text-cream/50 md:flex-row md:items-center md:justify-between">
      <p>&copy; {{ 'now'|date('Y') }} {{ site.coffee.copyright|default(site.title) }}</p>
      {%- if site.menus.legal is defined %}
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {%- for entry in site.menus.legal|sort_by_weight %}
        <li><a href="{{ url(entry) }}" class="transition hover:text-cream">{{ entry.name }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
      <p><a href="https://cecil.app" class="transition hover:text-cream">{{ 'Powered by %powered_by%'|trans({'%powered_by%': 'Cecil'}) }}</a></p>
    </div>
  </div>
</footer>
