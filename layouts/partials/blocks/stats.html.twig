{#- Stats: key figures. block.items: [{value, label}] -#}
<section id="{{ anchor }}" class="block-stack pb-24 {{ theme.classes }}">
  <div class="container-coffee">
    {{- include('partials/block-heading.html.twig') }}
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl lg:grid-cols-4 {{ theme.dark ? 'bg-cream/10' : 'bg-ink/10' }}">
      {%- for item in block.items|default([]) %}
      <div class="flex flex-col gap-2 p-8 {{ theme.classes }}" data-reveal style="transition-delay: {{ loop.index0 * 80 }}ms">
        <dt class="order-last text-sm font-semibold uppercase tracking-widest opacity-70">{{ item.label }}</dt>
        <dd class="heading text-5xl text-coffee sm:text-6xl">{{ item.value }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>
