{#- Features: numbered columns (values, services, steps…).
    block.items: [{title, text, url}], block.columns: 2 | 3 (default) | 4 -#}
{%- set columns = {2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4'} -%}
<section id="{{ anchor }}" class="block-stack pb-24 {{ theme.classes }}">
  <div class="container-coffee">
    {{- include('partials/block-heading.html.twig') }}
    <ol class="grid gap-10 {{ columns[block.columns|default(3)]|default(columns[3]) }}">
      {%- for item in block.items|default([]) %}
      <li class="border-t-2 pt-6 {{ theme.dark ? 'border-cream/15' : 'border-ink/15' }}" data-reveal style="transition-delay: {{ loop.index0 * 80 }}ms">
        <span class="heading text-5xl text-coffee">{{ '%02d'|format(loop.index) }}</span>
        <h3 class="heading mt-4 text-2xl">
          {%- if item.url|default(null) %}<a href="{{ url(item.url) }}" class="hover:text-coffee">{{ item.title }}</a>{% else %}{{ item.title }}{% endif -%}
        </h3>
        {%- if item.text|default(null) %}
        <div class="mt-3 space-y-3 {{ theme.dark ? 'text-cream/70' : 'text-ink/70' }}">{{ item.text|markdown_to_html }}</div>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>